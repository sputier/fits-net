# Text files are LF in the repository and in the working tree, whatever core.autocrlf says: the generated documentation is compared
# byte for byte in CI and the sources must not change line endings from one machine to the next.
* text=auto eol=lf

# Binary files: never converted.
*.fits binary
*.fz binary
*.raw binary
*.png binary
*.gz binary
*.nupkg binary
*.snupkg binary
