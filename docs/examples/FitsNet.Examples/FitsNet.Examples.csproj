<Project Sdk="Microsoft.NET.Sdk">

  <!-- The code samples of the documentation. Each #region Example:Name is copied into the Markdown pages by tools/DocGen,
       and the tests run every method, so the samples in the guide always compile and work. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FitsNet" />
    <Using Include="FitsNet.Wcs" />
    <Using Include="FitsNet.Compression" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FitsNet\FitsNet.csproj" />
  </ItemGroup>

</Project>
