<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Pure managed .NET library to read, write and manipulate FITS (Flexible Image Transport System) files.</Description>
  </PropertyGroup>

  <!-- NuGet package. The version is the single source of the release: the release workflow checks that the tag matches it. -->
  <PropertyGroup>
    <PackageId>Eleris.FitsNet</PackageId>
    <Version>0.3.0</Version>
    <Authors>Sébastien Putier</Authors>
    <Copyright>Copyright (c) 2026 Sébastien Putier</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>fits;astronomy;astropy;image;wcs;table;compression;science</PackageTags>
    <PackageProjectUrl>https://github.com/sputier/fits-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sputier/fits-net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The last version on nuget.org: the package validation refuses any change of its API that is not compatible. -->
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Paths of the build machine must not end up in the binaries of a package built by the CI. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eleris.FitsNet.Tests" />
  </ItemGroup>

</Project>
